void main_vertex()
{
    // --- fragment: unpackNormalTangent   (cond 01022c0000000000080044000000000000000100000001ff)
    Current.normal.xyz  = Current.normal.xyz  * 1.0/127.0 - 1;
    Current.tangent.xyz = Current.tangent.xyz * 1.0/127.0 - 1;
    // --- fragment: unpackNormal   (cond 01022c0000000000000004000000000000000100000001ff)
    Current.normal.xyz = Current.normal.xyz * 1.0/127.0 - 1;
    // --- fragment: screenInfo   (cond 0000000000000000000000000000000000000000000000ff)
    float hw = Current.position.w;
    // --- fragment: hdWaterMinSpecVS   (cond 0000000000000000000000000000000000000000000000ff)
    {
    half uvScale = terrainRegionInfoVS.mMisc.y;  
    half2 flatPos = Current.position.xy;
    half2 gridUV = flatPos.xy / uvScale;  
    half4 tessellation = terrainRegionInfoVS.mTessellation.xyzw;  
    gridUV *= -1;
    half4 morph = half4(0,0,0,0);
    morph.x = (gridUV.y > 0) && (abs(gridUV.y) > abs(gridUV.x)) ? tessellation.x : 0;  
    morph.y = (gridUV.y < 0) && (abs(gridUV.y) > abs(gridUV.x)) ? tessellation.y : 0;  
    morph.z = (gridUV.x > 0) && (abs(gridUV.x) > abs(gridUV.y)) ? tessellation.z : 0;  
    morph.w = (gridUV.x < 0) && (abs(gridUV.x) > abs(gridUV.y)) ? tessellation.w : 0;  
    half morphAmount = 0;  
    half2 morphStep = terrainRegionInfoVS.mMorph.xy;  
    morphStep *= Current.position.zw;  
    flatPos += morphStep * morphAmount;
    half2 terrainHeightMapUV = flatPos.xy / uvScale;
    terrainHeightMapUV += half2(0.5, 0.5);
    terrainHeightMapUV.xy *= terrainRegionInfoVS.mMapping.xy;
    terrainHeightMapUV.xy += terrainRegionInfoVS.mMapping.zw;
    half4 transformedPos = mul(terrainRegionInfoVS.mMatrix, half4(flatPos, 0, 1));
    flatPos.xy = transformedPos.xy;
    half waterLevel = terrainRegionInfoVS.mMisc.x;
    half2 waterHeightMapUV = (flatPos.xy / 16384.0);  
    half3 worldPos = half3(flatPos.xy, waterLevel);
    Current.position = half4(worldPos, 1);
    Current.texcoord<t0> = half4(waterHeightMapUV, terrainHeightMapUV);
    Current.texcoord<t1> = half4(terrainRegionInfoVS.mMorph);  
    Current.texcoord<t1>.x = waterLevel;  
    Current.texcoord<t2> = Current.position;
    }
    // --- fragment: toClipSpace   (cond 0000000000000000000000000000000000000000000000ff)
    float4 worldPosition = float4(mul(Current.position, modelToWorld), 1);
    float4 clipPosition = mul(Current.position, modelToClip);
    Current.position = clipPosition;
}

